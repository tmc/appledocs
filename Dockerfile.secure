# Secure multi-stage Dockerfile for appledocs
# This Dockerfile implements maximum security with scratch base image

# Build stage
FROM golang:1.24-alpine AS builder

# Install security updates and certificates
RUN apk update && \
    apk upgrade && \
    apk add --no-cache ca-certificates git && \
    rm -rf /var/cache/apk/*

# Create non-root user for build
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set up build directory
WORKDIR /build

# Copy go mod files for better layer caching
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build with security hardening flags
# - Strip debug information (-w -s)
# - Static linking (-extldflags "-static")
# - Disable symbol table (-s)
# - Disable DWARF generation (-w)
# - Force rebuild of packages (-a)
# - Use pure Go implementations (CGO_ENABLED=0)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -trimpath \
    -o appledocs .

# Create minimal filesystem structure
RUN mkdir -p /app/cache /app/output && \
    chown -R appuser:appgroup /app

# Final stage - scratch image for maximum security
FROM scratch

# Copy only necessary files from builder
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder --chown=1001:1001 /app /app
COPY --from=builder /build/appledocs /appledocs

# Set working directory
WORKDIR /app

# Use non-root user
USER 1001:1001

# Document exposed volumes for cache and output
VOLUME ["/app/cache", "/app/output"]

# Set security labels
LABEL security.scan="true" \
      security.nonroot="true" \
      security.no-new-privileges="true" \
      maintainer="security@appledocs.local"

# Run the binary
ENTRYPOINT ["/appledocs"]
CMD ["-cache", "/app/cache", "-output", "/app/output"]