-- methods.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

import "unsafe"

// Method-style wrappers for {{.Framework}} functions.
// These provide a more idiomatic Go API by grouping related functions as methods on receiver types.

{{range $typeName, $methods := .TypeMethods -}}
{{range $methods -}}
{{- $docData := prepareFunctionDocData . $.Framework}}
{{if $docData.Abstract}}// {{$docData.Abstract}} [Full Topic]{{else}}// {{$docData.MethodName}} is a {{$docData.Framework}} function. [Full Topic]{{end}}
{{if $docData.HasAvailability -}}
//
{{if $docData.IsDeprecated -}}
// Deprecated: This function was deprecated in {{$docData.DeprecatedPlatform}} {{$docData.DeprecatedVersion}}.
//
{{end -}}
// Added in {{$docData.IntroducedPlatform}} {{$docData.IntroducedVersion}}.
{{end -}}
{{if $docData.DocURL -}}
//
// [Full Topic]: {{$docData.DocURL}}
{{end -}}
func (c {{index $.TypeToRef $typeName}}) {{$docData.MethodName}}({{range $i, $p := $docData.MethodParameters}}{{if $i}}, {{end}}{{$p.Name}} {{$p.Type}}{{end}}){{if $docData.ReturnType}} {{$docData.ReturnType}}{{end}} {
	{{if $docData.ReturnType}}return {{end}}{{$docData.Name}}(c.Ptr(){{if $docData.MethodParameters}}, {{end}}{{range $i, $p := $docData.MethodParameters}}{{if $i}}, {{end}}{{$p.Name}}{{end}})
}

{{end -}}
{{end -}}

-- functions_test.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}_test

import (
	"testing"
	"unsafe"

	"{{.PackageName}}"
)

{{range .Functions -}}
{{- $docData := prepareFunctionDocData . $.Framework}}
// Test{{$docData.Name}} tests the {{$docData.Name}} function.
// This is a basic smoke test that verifies the function can be called without panicking.
func Test{{$docData.Name}}(t *testing.T) {
	{{if eq (len $docData.Parameters) 0 -}}
	// Function takes no parameters - call directly
	{{if $docData.ReturnType -}}
	_ = {{$.PackageName}}.{{$docData.Name}}()
	{{else -}}
	{{$.PackageName}}.{{$docData.Name}}()
	{{end -}}
	{{else -}}
	t.Skip("TODO: Provide test inputs for {{$docData.Name}}({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Type}}{{end}})")
	{{end -}}
}

{{end}}

-- examples_test.gen.go --
