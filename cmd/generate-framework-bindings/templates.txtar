# Code generation templates for Apple framework bindings
# These templates use occ2go helpers via FuncMap for type mapping and parameter processing

-- module --
# Generated bindings for {{.Framework}} framework
# Package: {{.PackageName}}
#
# Functions: {{.FunctionCount}}
# Classes: {{.ClassCount}}
# Protocols: {{.ProtocolCount}}

#-- generate.go --
{{template "generate.go" .}}

#-- doc.gen.go --

{{template "doc.gen.go" .}}
#-- types.gen.go --
{{template "types.gen.go" .}}

{{- $undefinedTypes := .GetUndefinedTypesForTemplate}}
{{if gt (len $undefinedTypes) 0 -}}
#-- undefined_types.gen.go --
{{template "undefined_types.gen.go" .}}
{{end -}}

{{if gt .EnumCount 0 -}}
#-- enums.gen.go --
{{template "enums.gen.go" .}}
{{end -}}

{{if gt .TypedefCount 0 -}}
#-- typedefs.gen.go --
{{template "typedefs.gen.go" .}}
{{end -}}

{{if gt .ConstantCount 0 -}}
#-- constants.gen.go --
{{template "constants.gen.go" .}}
{{end -}}

#-- functions.gen.go --
{{template "functions.gen.go" .}}

{{if or (gt .ClassCount 0) (gt .FunctionCount 0) .GenerateTests .GenerateExamples -}}
#-- main_test.go --
{{template "main_test.go" .}}
{{end -}}

{{if .WithRefMethods -}}
#-- methods.gen.go --
{{template "methods.gen.go" .}}
{{end -}}

{{if gt .ClassCount 0 -}}
{{- range .Classes}}
#-- {{classFileName .Name}} --
{{template "class.gen.go" (dict "Generator" $ "Class" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}
{{if hasIOSOnlyMethods . -}}
#-- {{classIOSFileName .Name}} --
{{template "class_ios.gen.go" (dict "Generator" $ "Class" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}
{{end -}}
{{if and (classHasInit .Methods) (not (shouldExcludeTestExample $.Framework .Name)) -}}
#-- {{classTestFileName .Name}} --
{{template "class.gen_test.go" (dict "Generator" $ "Class" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}{{end}}{{end}}{{end}}

{{if gt .ProtocolCount 0 -}}
{{- range .Protocols}}
#-- {{protocolFileName .Name}} --
{{template "protocol.gen.go" (dict "Generator" $ "Protocol" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}

#-- {{protocolInterfaceFileName .Name}} --
{{template "protocol_interface.gen.go" (dict "Generator" $ "Protocol" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}{{end}}{{end}}

{{if .GenerateTests -}}
#-- functions.gen_test.go --
{{template "functions.gen_test.go" .}}
{{end -}}

{{if .GenerateExamples -}}
#-- examples_test.gen.go --
{{template "examples_test.gen.go" .}}
{{end -}}

-- _doc_comment.tmpl --
{{/* Reusable template for documentation comments with [Full Topic] links */}}
{{define "doc_comment"}}
{{- if .Abstract}}
// {{commentLine .Abstract}}{{if not .DocURL}} [Full Topic]{{end}}
{{- end}}
{{- if .DocURL}}
{{if .Abstract}}//
{{end}}// [Full Topic]
// [Full Topic]: {{convertDocURL .DocURL}}
{{- end -}}
{{end}}

-- generate.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

//go:generate rm -f *.gen.go *.gen_test.go
//go:generate go run github.com/tmc/appledocs/cmd/generate-framework-bindings -framework ^{{.Framework}}${{if .Variant}} -variant {{.Variant}}{{end}}{{if .WithRefMethods}} -with-ref-methods{{end}} -output ..

-- doc.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

{{if .Abstract -}}
// Package {{.PackageName}} provides Go bindings for the {{.Framework}} framework.
//
// {{.Abstract}}
//
{{else -}}
// Package {{.PackageName}} provides Go bindings for the {{.Framework}} framework.
//
{{end -}}
// These bindings are generated from Apple's official documentation and
// provide purego-based access to {{.Framework}} without requiring cgo.
{{if .DocURL -}}
//
// See: {{convertDocURL .DocURL}}
{{end -}}
package {{.PackageName}}

import (
	"github.com/ebitengine/purego"
)

// frameworkPath is the system path to the framework binary.
{{if eq .Framework "ObjectiveC" -}}
const frameworkPath = "/usr/lib/libobjc.dylib"
{{else -}}
const frameworkPath = "/System/Library/Frameworks/{{.Framework}}.framework/{{.Framework}}"
{{end -}}
func init() {
	_, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
}
-- types.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}
{{- $needsUnsafe := or .WithRefMethods (gt (len .RefTypes) 0) (structsUseUnsafe .Structs .Framework)}}
{{- $needsObjc := structsUseObjc .Structs .Framework}}
{{- $crossFrameworkImports := getStructCrossFrameworkImports .Structs .Framework .OutputModule}}
{{- if or $needsUnsafe $needsObjc (gt (len $crossFrameworkImports) 0)}}
import (
{{- if $needsUnsafe}}
	"unsafe"
{{- end}}
{{- if $needsObjc}}
	"github.com/ebitengine/purego/objc"
{{- end}}
{{- range $pkg, $path := $crossFrameworkImports}}

	"{{$path}}"
{{- end}}
)

{{- end}}
{{if .WithRefMethods -}}
{{range .RefTypes -}}
// {{.}} is a CoreGraphics opaque type.
//
// The underlying representation is unsafe.Pointer, wrapped to allow methods.
type {{.}} struct {
	p unsafe.Pointer
}

// To{{.}} converts an unsafe.Pointer to {{.}}.
func To{{.}}(p unsafe.Pointer) {{.}} {
	return {{.}}{p: p}
}

// Ptr returns the underlying unsafe.Pointer.
func (ref {{.}}) Ptr() unsafe.Pointer {
	return ref.p
}

{{end}}
{{end}}

{{if gt (len .Structs) 0 -}}
// C struct types
{{range .Structs -}}
// {{.Name}}{{if .Abstract}} - {{.Abstract}}{{end}}
{{if .DocURL -}}
//
// [Full Topic]
// [Full Topic]: {{convertDocURL .DocURL}}
{{end -}}
type {{.Name}} struct {
{{- range .Fields}}
	{{.Name}} {{mapCTypeToGo .Type $.Framework}}{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
}{{debug "types.gen.go/struct" .Name }}

{{if hasPrefix .Name "NS" -}}
{{$strippedName := trimPrefix .Name "NS" -}}
// {{$strippedName}} is a type alias for {{.Name}} for use in objc.Send[T] calls.
type {{$strippedName}} = {{.Name}}

{{end -}}
{{end}}
{{end}}

-- undefined_types.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

{{- $undefinedTypes := .GetUndefinedTypesForTemplate}}

// _undefined is the base type for all undefined types referenced in documentation
// but not defined. These types are typically enums, options, or type aliases that
// weren't extracted from the documentation.
type _undefined = int

// Undefined types - referenced but not defined in documentation
type (
{{- range $undefinedTypes}}
	{{.Name}} = _undefined // referenced in {{.Framework}}
{{- end}}
)

-- functions.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

{{debug "functions.gen.go" "Generating %d functions for %s" (len .Functions) .Framework}}
{{if gt (len .Functions) 0 -}}
{{- $funcImports := getFunctionRequiredImports .Functions .Framework -}}
{{- $sortedImports := sortedImportPaths $funcImports -}}
import (
	"unsafe"

	"github.com/ebitengine/purego"
{{- range $sortedImports}}
	{{.PackageName}} "{{.ImportPath}}"
{{- end}}
)
{{else -}}
import (
	"github.com/ebitengine/purego"
)
{{end}}

// {{.Framework}} Functions ({{.Count}} total)
//
// Type-safe package-level functions with graceful error handling.
// Missing symbols are silently ignored during init; functions will panic when called if unavailable.

{{if gt (len .Functions) 0 -}}
var (
{{- range .Functions}}
{{- $params := prepareParams .Parameters $.Framework}}
{{- $returnType := mapCTypeToGo .ReturnType $.Framework}}
	_{{.Name}} func({{range $i, $p := $params}}{{if $i}}, {{end}}{{$p.Type}}{{end}}){{if $returnType}} {{$returnType}}{{end}}
{{- end}}
)

func init() {
	lib, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
{{- range .Functions}}
	tryRegister(&_{{.Name}}, lib, "{{.Name}}")
{{- end}}
}

// tryRegister attempts to register a function, silently ignoring failures.
// This allows the library to load even if some symbols are missing.
func tryRegister(fn interface{}, lib uintptr, name string) {
	defer func() {
		if r := recover(); r != nil {
			// Symbol not found - function will remain nil and panic when called
			// This is expected for inline functions, macros, or version-specific APIs
		}
	}()
	purego.RegisterLibFunc(fn, lib, name)
}
{{else -}}
func init() {
	// Framework has no exported C functions, only classes/protocols
	lib, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
	_ = lib // Suppress unused variable warning
}
{{end}}

{{range .Functions -}}
{{- $docData := prepareFunctionDocData . $.Framework}}
{{if $docData.Abstract}}// {{commentLine $docData.Abstract}}{{if not $docData.DocURL}} [Full Topic]{{end}}{{else}}// {{$docData.Name}} is a {{$docData.Framework}} function.{{if not $docData.DocURL}} [Full Topic]{{end}}{{end}}
{{if $docData.HasAvailability -}}
//
{{if $docData.IsDeprecated -}}
// Deprecated: This function was deprecated in {{$docData.DeprecatedPlatform}} {{$docData.DeprecatedVersion}}.
//
{{end -}}
// Added in {{$docData.IntroducedPlatform}} {{$docData.IntroducedVersion}}.
{{- end -}}
{{if $docData.DocURL -}}
{{template "doc_comment" $docData}}
{{end -}}
func {{$docData.Name}}({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}} {{$p.Type}}{{end}}){{if $docData.ReturnType}} {{$docData.ReturnType}}{{end}} {
	{{if $.WithRefMethods -}}
	fn := _{{$docData.Name}}.(func({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}unsafe.Pointer{{end}}){{if $docData.ReturnType}} unsafe.Pointer{{end}})
	{{if $docData.ReturnType}}ret := {{end}}fn({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}}.Ptr(){{end}})
	{{if $docData.ReturnType -}}
	return To{{$docData.ReturnType}}(ret)
	{{- end -}}
	{{else -}}
	{{if $docData.ReturnType}}return {{end}}_{{$docData.Name}}({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}}{{end}})
	{{- end}}
}{{debug "functions.gen.go/function" $docData.Name }}
{{end}}

-- class_ios.gen.go --
//go:build darwin && ios

// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

import (
	"unsafe"

	"{{.OutputModule}}/objc"
{{- $imports := getClassImports .Class $.Framework $.OutputModule}}
{{- $sortedImports := getSortedClassImports $imports}}
{{- range $sortedImports}}
	"{{.ImportPath}}"
{{- end}}
)

{{with .Class -}}
{{$framework := $.Framework -}}
{{$className := .Name -}}
{{$structName := classToStructName .Name -}}
{{$classTypeName := print "_" $structName "Class" -}}
{{$classReceiver := receiverName $structName true -}}
{{$instReceiver := receiverName $structName false -}}

// iOS-only methods for {{$structName}}
{{range filterPropertyMethods .}}
{{- if and (not (isEssentialSelector .Selector)) (eq (len .Availability.DeprecatedAt) 0) (iosOnlyMethod .)}}
{{- $paramNames := formatMethodParamNamesWithFramework . $framework}}
{{- $goType := mapObjCTypeToGo .ReturnType $framework}}
{{- $returnType := $goType}}
{{- if eq $goType $className}}{{$returnType = $structName}}{{else}}{{$returnType = typeToInterfaceType $goType}}{{end}}
{{- $isInitMethod := hasPrefix .Selector "init"}}
{{- $hasValidReturnType := or $isInitMethod (eq .ReturnType "") (eq .ReturnType "void") (ne $goType "")}}
{{- if $hasValidReturnType}}
{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$instReceiver}} {{$structName}}) {{.Name}}({{formatMethodParams .}}){{if $isInitMethod}} {{$structName}}{{else}}{{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$returnType}}{{end}}{{end}} {
	{{- if $isInitMethod}}
	rv := objc.Send[{{$structName}}]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	return rv
	{{- else if and (ne .ReturnType "") (ne .ReturnType "void")}}
	rv := objc.Send[{{concreteReturnType $goType}}]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- if and (eq (concreteReturnType $goType) "objc.ID") (eq $returnType "IObject")}}
	return Object{ID: rv}
	{{- else if and (eq (concreteReturnType $goType) "[]objc.ID") (or (eq $returnType "[]IObject") (eq $returnType "[]objc.IObject"))}}
	result := make([]objc.IObject, len(rv))
	for i, id := range rv {
		result[i] = objc.Object{ID: id}
	}
	return result
	{{- else if and (hasPrefix (concreteReturnType $goType) "[]") (ne (concreteReturnType $goType) $returnType)}}
	// Slice of concrete type to slice of interface - needs conversion
	result := make({{$returnType}}, len(rv))
	for i, v := range rv {
		result[i] = v
	}
	return result
	{{- else}}
	return rv
	{{- end}}
	{{- else}}
	objc.Send[objc.ID]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- end}}
}
{{- end}}
{{- end}}
{{- end}}

// iOS-only properties
{{- range .Properties}}
{{- if and (not .IsClassProperty) (iosOnlyProperty .)}}
{{- $typeToMap := .Type}}{{if .ObjCType}}{{$typeToMap = .ObjCType}}{{end}}
{{- $goType := mapObjCTypeToGo $typeToMap $framework}}
{{- $returnType := typeToInterfaceType $goType}}
{{- $capitalizedName := capitalize .Name}}
{{- $conflictsWithParent := propertyConflictsWithParent $className $.Class.SuperClass .Name}}
{{- if and (ne $goType "") (not $conflictsWithParent)}}

{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$instReceiver}} {{$structName}}) {{$capitalizedName}}() {{$returnType}} {
	rv := objc.Send[{{concreteReturnType $goType}}]({{$instReceiver}}.ID, objc.Sel("{{.Name}}"))
	{{- if and (eq (concreteReturnType $goType) "objc.ID") (eq $returnType "IObject")}}
	return Object{ID: rv}
	{{- else if and (eq (concreteReturnType $goType) "[]objc.ID") (eq $returnType "[]IObject")}}
	result := make([]IObject, len(rv))
	for i, id := range rv {
		result[i] = Object{ID: id}
	}
	return result
	{{- else}}
	return rv
	{{- end}}
}

{{- $isReadOnly := contains .Attributes "readonly"}}
{{- if not $isReadOnly}}
{{- $setterParamType := typeToInterfaceType $goType}}
func ({{$instReceiver}} {{$structName}}) Set{{$capitalizedName}}(value {{$setterParamType}}) {
	{{$instReceiver}}.ID.Send(objc.RegisterName("set{{$capitalizedName}}:"), value)
}
{{- end}}
{{- end}}
{{- end}}
{{- end}}

{{end}}

-- _class_header.tpl --
{{define "class_header"}}
{{debug "class_header" "Header for %s" .ClassName}}
// The class instance for the [{{.StructName}}] class.
var (
	{{.VarName}}     {{.ClassTypeName}}
	{{.VarName}}Once sync.Once
)

func get{{.StructName}}Class() {{.ClassTypeName}} {
	{{.VarName}}Once.Do(func() {
		{{.VarName}} = {{.ClassTypeName}}{objc.GetClass("{{.ClassName}}")}
	})
	return {{.VarName}}
}

type {{.ClassTypeName}} struct {
	class objc.Class
}
{{debug "class_header" "End header"}}
{{end}}

-- _class_struct.tpl --
{{define "class_struct"}}
{{debug "class_struct" "Struct for %s" .StructName}}
{{if .Abstract -}}
// {{commentLine .Abstract}}
{{if .Overview}}//
// {{commentLine .Overview}}
{{end -}}
{{end -}}
{{if or .Abstract .DocURL}}
{{template "doc_comment" .Class}}
{{end -}}
type {{.StructName}} struct {
	{{getStructEmbeddedField .Class .Framework}}
}

// {{.StructName}}From constructs a [{{.StructName}}] from an unsafe.Pointer.
{{if .Abstract -}}
//
// {{commentLine .Abstract}}
{{end -}}
func {{.StructName}}From(ptr unsafe.Pointer) {{.StructName}} {
	{{getFromConstructorBody .Class .Framework}}
}
{{debug "class_struct" "End struct"}}
{{end}}

-- _class_interface.tpl --
{{define "class_interface"}}
{{debug "class_interface" "Interface for %s" .StructName}}
// An interface definition for the [{{.StructName}}] class.
type I{{.StructName}} interface {
	{{getInterfaceParent .Class}}
	{{template "class_interface_properties" .}}
	{{template "class_interface_methods" .}}
}
{{debug "class_interface" "End interface"}}
{{end}}

{{define "class_interface_properties"}}
{{debug "class_interface_properties" "Properties for %s" .StructName}}
	// properties:
	{{- range .Class.Properties}}
	{{- if and (not .IsClassProperty) (not (iosOnlyProperty .))}}
	{{- $typeToMap := .Type}}{{if .ObjCType}}{{$typeToMap = .ObjCType}}{{end}}
	{{- $goType := mapObjCTypeToGo $typeToMap $.Framework}}
	{{- $returnType := typeToInterfaceType $goType}}
	{{- $capitalizedName := capitalize .Name}}
	{{- $conflictsWithParent := propertyConflictsWithParent $.ClassName $.Class.SuperClass .Name}}
	{{- $conflictsWithParentMethod := propertyConflictsWithParentMethod . $.Class $.Framework}}
	{{- if and (ne $goType "") (not $conflictsWithParent) (not $conflictsWithParentMethod)}}
	{{$capitalizedName}}() {{$returnType}}
	{{- $isReadOnly := contains .Attributes "readonly"}}
	{{- if not $isReadOnly}}
	{{- $setterParamType := typeToInterfaceType $goType}}
	Set{{$capitalizedName}}(value {{$setterParamType}})
	{{- end}}
	{{- end}}
	{{- end}}
	{{- end}}
{{debug "class_interface_properties" "End properties"}}
{{end}}

{{define "class_interface_methods"}}
{{debug "class_interface_methods" "Methods for %s" .StructName}}
	// methods:
	{{- range filterPropertyMethods .Class}}
	{{- if and (not (isEssentialSelector .Selector)) (not (isInheritedFromNSObject .Selector)) (eq (len .Availability.DeprecatedAt) 0) (not (iosOnlyMethod .)) (not (methodConflictsWithParent . $.Class $.Framework))}}
	{{- $goType := mapObjCTypeToGo .ReturnType $.Framework}}
	{{- $interfaceType := typeToInterfaceType $goType}}
	{{- $isInitMethod := hasPrefix .Selector "init"}}
	{{- $hasValidReturnType := or $isInitMethod (eq .ReturnType "") (eq .ReturnType "void") (ne $goType "")}}
	{{- if $hasValidReturnType}}
	{{.Name}}({{formatMethodParams .}}){{if $isInitMethod}} {{$.StructName}}{{else}}{{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$interfaceType}}{{end}}{{end}}
	{{- end}}
	{{- end}}
	{{- end}}
{{debug "class_interface_methods" "End methods"}}
{{end}}

-- _class_constructors.tpl --
{{define "class_constructors"}}
{{debug "class_constructors" "Constructors for %s" .StructName}}
// Alloc allocates a new instance without initialization.
func ({{.ClassReceiver}} {{.ClassTypeName}}) Alloc() {{.StructName}} {
	rv := objc.Send[{{.StructName}}](objc.ID({{.ClassReceiver}}.class), objc.Sel("alloc"))
	return rv
}

// New creates and returns a new autoreleased instance (equivalent to [[Class alloc] init]).
func ({{.ClassReceiver}} {{.ClassTypeName}}) New() {{.StructName}} {
	rv := objc.Send[{{.StructName}}](objc.ID({{.ClassReceiver}}.class), objc.Sel("new"))
	rv.Autorelease()
	return rv
}

// Init initializes the instance.
func ({{.InstReceiver}} {{.StructName}}) Init() {{.StructName}} {
	rv := objc.Send[{{.StructName}}]({{.InstReceiver}}.ID, objc.Sel("init"))
	return rv
}

// Autorelease adds the receiver to the current autorelease pool.
func ({{.InstReceiver}} {{.StructName}}) Autorelease() {{.StructName}} {
	rv := objc.Send[{{.StructName}}]({{.InstReceiver}}.ID, objc.Sel("autorelease"))
	return rv
}

// New{{.StructName}} creates a new {{.StructName}} instance.
func New{{.StructName}}() {{.StructName}} {
	return get{{.StructName}}Class().New()
}
{{debug "class_constructors" "End constructors"}}
{{end}}

-- _class_init_methods.tpl --
{{define "class_init_methods"}}
{{debug "class_init_methods" "Init methods for %s" .StructName}}
{{- if .Class.HasInitMethods -}}
{{- range prepareInitMethodsWithClassName .ClassName .Class.Methods}}
{{- if ne .Selector "init"}}
{{- $constructorName := initMethodToConstructorName $.ClassName .Selector}}
{{- $paramNames := formatMethodParamNamesWithFramework . $.Framework}}
{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func {{$constructorName}}({{formatMethodParams .}}) {{$.StructName}} {
{{getConstructorBody . $.StructName $paramNames}}
}{{debug "class_init_methods/constructor" $constructorName }}
{{end}}
{{- end}}
{{end -}}
{{debug "class_init_methods" "End init methods"}}
{{end}}

-- _class_methods.tpl --
{{define "class_methods"}}
{{debug "class_methods" "Class methods for %s" .StructName}}
{{- range prepareClassMethods .Class.Methods}}
{{- if not (isEssentialSelector .Selector)}}
{{- $paramNames := formatMethodParamNamesWithFramework . $.Framework}}
{{- $goType := mapObjCTypeToGo .ReturnType $.Framework}}
{{- $returnType := $goType}}
{{- if eq $goType $.ClassName}}{{$returnType = $.StructName}}{{else}}{{$returnType = typeToInterfaceType $goType}}{{end}}
{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$.ClassReceiver}} {{$.ClassTypeName}}) {{.Name}}({{formatMethodParams .}}){{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$returnType}}{{end}} {
	{{- if and (ne .ReturnType "") (ne .ReturnType "void")}}
	rv := objc.Send[{{concreteReturnType $goType}}](objc.ID({{$.ClassReceiver}}.class), objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- if and (eq (concreteReturnType $goType) "objc.ID") (eq $returnType "IObject")}}
	return Object{ID: rv}
	{{- else if and (eq (concreteReturnType $goType) "[]objc.ID") (eq $returnType "[]IObject")}}
	result := make([]IObject, len(rv))
	for i, id := range rv {
		result[i] = Object{ID: id}
	}
	return result
	{{- else}}
	return rv
	{{- end}}
	{{- else}}
	objc.Send[objc.ID](objc.ID({{$.ClassReceiver}}.class), objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- end}}
}{{debug "class_methods/method" "Class method for" .Name }}
{{end}}
{{- end}}
{{debug "class_methods" "End class methods"}}
{{end}}

{{define "class_properties_class"}}
{{debug "class_properties_class" "Class properties for %s" .StructName}}
{{- range .Class.Properties}}
{{- if .IsClassProperty}}
{{- $goType := mapObjCTypeToGo .Type $.Framework}}
{{- $returnType := $goType}}
{{- if eq $goType $.ClassName}}{{$returnType = $.StructName}}{{else}}{{$returnType = typeToInterfaceType $goType}}{{end}}
{{- $capitalizedName := capitalize .Name}}
{{- $conflictsWithParent := propertyConflictsWithParent $.ClassName $.Class.SuperClass .Name}}
{{- if and (ne $goType "") (not $conflictsWithParent)}}

{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$.ClassReceiver}} {{$.ClassTypeName}}) {{$capitalizedName}}() {{$returnType}} {
	rv := objc.Send[{{concreteReturnType $goType}}](objc.ID({{$.ClassReceiver}}.class), objc.Sel("{{.Name}}"))
	return rv
}{{debug "class_properties_class/property" .Name }}
{{- end}}
{{- end}}
{{- end}}
{{debug "class_properties_class" "End class properties"}}
{{end}}

{{define "instance_methods"}}
{{debug "instance_methods" "Instance methods for %s" .StructName}}
{{- range filterPropertyMethods .Class}}
{{- if and (not (isEssentialSelector .Selector)) (eq (len .Availability.DeprecatedAt) 0) (not (iosOnlyMethod .)) (not (methodConflictsWithParent . $.Class $.Framework))}}
{{- $paramNames := formatMethodParamNamesWithFramework . $.Framework}}
{{- $goType := mapObjCTypeToGo .ReturnType $.Framework}}
{{- $returnType := $goType}}
