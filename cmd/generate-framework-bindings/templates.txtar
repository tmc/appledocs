# Code generation templates for Apple framework bindings
# These templates use occ2go helpers via FuncMap for type mapping and parameter processing

-- module --
# Generated bindings for {{.Framework}} framework
# Package: {{.PackageName}}
#
# Functions: {{.FunctionCount}}
# Classes: {{.ClassCount}}
# Protocols: {{.ProtocolCount}}

#-- generate.go --
{{template "generate.go" .}}
#-- doc.gen.go --
{{template "doc.gen.go" .}}
#-- types.gen.go --
{{template "types.gen.go" .}}
{{if gt .EnumCount 0 -}}
#-- enums.gen.go --
{{template "enums.gen.go" .}}
{{end -}}
{{if gt .TypedefCount 0 -}}
#-- typedefs.gen.go --
{{template "typedefs.gen.go" .}}
{{end -}}
{{if gt .ConstantCount 0 -}}
#-- constants.gen.go --
{{template "constants.gen.go" .}}
{{end -}}
#-- functions.gen.go --
{{template "functions.gen.go" .}}
{{if or (gt .ClassCount 0) (gt .FunctionCount 0) .GenerateTests .GenerateExamples -}}
#-- main_test.go --
{{template "main_test.go" .}}
{{end -}}
{{if .WithRefMethods -}}
#-- methods.gen.go --
{{template "methods.gen.go" .}}
{{end -}}
{{if gt .ClassCount 0 -}}
{{- range .Classes}}
#-- {{classFileName .Name}} --
{{template "class.gen.go" (dict "Generator" $ "Class" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}
{{if and (classHasInit .Methods) (not (shouldExcludeTestExample $.Framework .Name)) -}}
#-- {{classTestFileName .Name}} --
{{template "class_test.gen.go" (dict "Generator" $ "Class" . "Framework" $.Framework "PackageName" $.PackageName "OutputModule" $.OutputModule)}}{{end}}{{end}}{{end}}
{{if gt .ProtocolCount 0 -}}
{{- range .Protocols}}
#-- {{protocolFileName .Name}} --
{{template "protocol.gen.go" (dict "Generator" $ "Protocol" . "Framework" $.Framework "PackageName" $.PackageName)}}{{end}}{{end}}
{{if .GenerateTests -}}
#-- functions.gen_test.go --
{{template "functions.gen_test.go" .}}
{{end -}}
{{if .GenerateExamples -}}
#-- examples_test.gen.go --
{{template "examples_test.gen.go" .}}
{{end -}}

-- _doc_comment.tmpl --
{{/* Reusable template for documentation comments with [Full Topic] links */}}
{{define "doc_comment"}}
{{- if .Abstract}}
// {{commentLine .Abstract}}{{if not .DocURL}} [Full Topic]{{end}}
{{- end}}
{{- if .DocURL}}
{{if .Abstract}}//
{{end}}// [Full Topic]
// [Full Topic]: {{convertDocURL .DocURL}}
{{- end -}}
{{end}}

-- generate.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

//go:generate rm -f *.gen.go *.gen_test.go
//go:generate go run github.com/tmc/appledocs/cmd/generate-framework-bindings -framework ^{{.Framework}}${{if .Variant}} -variant {{.Variant}}{{end}}{{if .WithRefMethods}} -with-ref-methods{{end}} -output ..

-- doc.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

{{if .Abstract -}}
// Package {{.PackageName}} provides Go bindings for the {{.Framework}} framework.
//
// {{.Abstract}}
{{else -}}
// Package {{.PackageName}} provides Go bindings for the {{.Framework}} framework.
{{end -}}
//
// These bindings are generated from Apple's official documentation and
// provide purego-based access to {{.Framework}} without requiring cgo.
{{if .DocURL -}}
{{template "doc_comment" .}}
{{end -}}
package {{.PackageName}}

import (
	"github.com/ebitengine/purego"
)

// frameworkPath is the system path to the framework binary.
{{if eq .Framework "ObjectiveC" -}}
const frameworkPath = "/usr/lib/libobjc.dylib"
{{else -}}
const frameworkPath = "/System/Library/Frameworks/{{.Framework}}.framework/{{.Framework}}"
{{end -}}
func init() {
	_, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
}
-- types.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

{{- $undefinedTypes := .GetUndefinedTypesForTemplate}}
{{- $hasImports := or .WithRefMethods (gt (len .RefTypes) 0) (gt (len $undefinedTypes) 0)}}
{{if $hasImports -}}
import (
{{- if or .WithRefMethods (gt (len .RefTypes) 0) (gt (len $undefinedTypes) 0)}}
	"unsafe"
{{- end}}
)

{{end -}}
{{if .WithRefMethods -}}
{{range .RefTypes -}}
// {{.}} is a CoreGraphics opaque type.
//
// The underlying representation is unsafe.Pointer, wrapped to allow methods.
type {{.}} struct {
	p unsafe.Pointer
}

// To{{.}} converts an unsafe.Pointer to {{.}}.
func To{{.}}(p unsafe.Pointer) {{.}} {
	return {{.}}{p: p}
}

// Ptr returns the underlying unsafe.Pointer.
func (ref {{.}}) Ptr() unsafe.Pointer {
	return ref.p
}

{{end}}
{{else -}}
{{range .RefTypes -}}
// {{.}} is a CoreGraphics opaque type.
type {{.}} unsafe.Pointer

{{end}}
{{end -}}

{{if eq .Framework "CoreGraphics" -}}
// CoreGraphics struct types
type CGFloat = float64

type CGPoint struct {
	X CGFloat
	Y CGFloat
}

type CGSize struct {
	Width  CGFloat
	Height CGFloat
}

type CGRect struct {
	Origin CGPoint
	Size   CGSize
}

type CGAffineTransform struct {
	A  CGFloat
	B  CGFloat
	C  CGFloat
	D  CGFloat
	Tx CGFloat
	Ty CGFloat
}

type CGVector struct {
	DX CGFloat
	DY CGFloat
}

// Common type aliases
type Range = CGPoint  // NSRange
type Size = CGSize    // NSSize
type Point = CGPoint  // NSPoint
type Rect = CGRect    // NSRect
{{end -}}

{{if or (eq .Framework "Foundation") (eq .Framework "ObjectiveC") -}}
// Type alias for NSTimeInterval
type TimeInterval = float64  // NSTimeInterval

{{end -}}
{{if eq .Framework "Foundation" -}}
// Foundation-specific types

// Foundation geometry types - compatible with NSPoint, NSSize, NSRect, NSRange
type Point struct {
	X float64
	Y float64
}

type Size struct {
	Width  float64
	Height float64
}

type Rect struct {
	Origin Point
	Size   Size
}

type Range struct {
	Location int
	Length   int
}

// RectEdge defines which edge of a rectangle.
type RectEdge int

const (
	RectEdgeMinX RectEdge = 0
	RectEdgeMinY RectEdge = 1
	RectEdgeMaxX RectEdge = 2
	RectEdgeMaxY RectEdge = 3
)

{{end -}}
{{if eq .Framework "QuartzCore" -}}
// QuartzCore needs CGFloat for its functions
type CGFloat = float64

{{end -}}
{{if eq .Framework "AppKit" -}}
// AppKit-specific type aliases
// WindowLevel represents a window's position in the z-axis
type WindowLevel = int  // NSWindowLevel

{{end -}}
{{if gt (len $undefinedTypes) 0}}
// Fallback type aliases for undefined types
// These types are referenced in method signatures but not fully documented.
// Using unsafe.Pointer as fallback to allow code generation.
{{range $undefinedTypes -}}
type {{.Name}} unsafe.Pointer

{{end}}
{{end -}}

-- functions.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

{{if gt (len .Functions) 0 -}}
{{- $funcImports := getFunctionRequiredImports .Functions .Framework -}}
{{- $sortedImports := sortedImportPaths $funcImports -}}
import (
	"unsafe"

	"github.com/ebitengine/purego"
{{- range $sortedImports}}
	{{.PackageName}} "{{.ImportPath}}"
{{- end}}
)
{{else -}}
import (
	"github.com/ebitengine/purego"
)
{{end}}

// {{.Framework}} Functions ({{.Count}} total)
//
// Type-safe package-level functions with graceful error handling.
// Missing symbols are silently ignored during init; functions will panic when called if unavailable.

{{if gt (len .Functions) 0 -}}
var (
{{- range .Functions}}
{{- $params := prepareParams .Parameters $.Framework}}
{{- $returnType := mapCTypeToGo .ReturnType $.Framework}}
	_{{.Name}} func({{range $i, $p := $params}}{{if $i}}, {{end}}{{$p.Type}}{{end}}){{if $returnType}} {{$returnType}}{{end}}
{{- end}}
)

func init() {
	lib, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
{{- range .Functions}}
	tryRegister(&_{{.Name}}, lib, "{{.Name}}")
{{- end}}
}

// tryRegister attempts to register a function, silently ignoring failures.
// This allows the library to load even if some symbols are missing.
func tryRegister(fn interface{}, lib uintptr, name string) {
	defer func() {
		if r := recover(); r != nil {
			// Symbol not found - function will remain nil and panic when called
			// This is expected for inline functions, macros, or version-specific APIs
		}
	}()
	purego.RegisterLibFunc(fn, lib, name)
}
{{else -}}
func init() {
	// Framework has no exported C functions, only classes/protocols
	lib, err := purego.Dlopen(frameworkPath, purego.RTLD_LAZY|purego.RTLD_GLOBAL)
	if err != nil {
		panic(err)
	}
	_ = lib // Suppress unused variable warning
}
{{end}}

{{range .Functions -}}
{{- $docData := prepareFunctionDocData . $.Framework}}
{{if $docData.Abstract}}// {{commentLine $docData.Abstract}}{{if not $docData.DocURL}} [Full Topic]{{end}}{{else}}// {{$docData.Name}} is a {{$docData.Framework}} function.{{if not $docData.DocURL}} [Full Topic]{{end}}{{end}}
{{if $docData.HasAvailability -}}
//
{{if $docData.IsDeprecated -}}
// Deprecated: This function was deprecated in {{$docData.DeprecatedPlatform}} {{$docData.DeprecatedVersion}}.
//
{{end -}}
// Added in {{$docData.IntroducedPlatform}} {{$docData.IntroducedVersion}}.
{{end -}}
{{if $docData.DocURL -}}
{{template "doc_comment" $docData}}
{{end -}}
func {{$docData.Name}}({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}} {{$p.Type}}{{end}}){{if $docData.ReturnType}} {{$docData.ReturnType}}{{end}} {
	{{if $.WithRefMethods -}}
	fn := _{{$docData.Name}}.(func({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}unsafe.Pointer{{end}}){{if $docData.ReturnType}} unsafe.Pointer{{end}})
	{{if $docData.ReturnType}}ret := {{end}}fn({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}}.Ptr(){{end}})
	{{if $docData.ReturnType -}}
	return To{{$docData.ReturnType}}(ret)
	{{end -}}
	{{else -}}
	{{if $docData.ReturnType}}return {{end}}_{{$docData.Name}}({{range $i, $p := $docData.Parameters}}{{if $i}}, {{end}}{{$p.Name}}{{end}})
	{{end -}}
}

{{end}}

-- classes.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

import (
	"sync"
	"unsafe"

	"github.com/ebitengine/purego/objc"
	{{- if ne .Framework "Foundation"}}
	"github.com/tmc/appledocs/generated/foundation"
	{{- end}}
	{{- if ne .Framework "CoreGraphics"}}
	"github.com/tmc/appledocs/generated/coregraphics"
	{{- end}}
	{{- if ne .Framework "AppKit"}}
	"github.com/tmc/appledocs/generated/appkit"
	{{- end}}
	{{- if ne .Framework "QuartzCore"}}
	"github.com/tmc/appledocs/generated/quartzcore"
	{{- end}}
)

// {{.Framework}} Classes - Objective-C runtime bindings
//
// This file contains class declarations and methods discovered from Apple's documentation.
// These use purego/objc runtime bindings to provide Go wrappers for Objective-C classes.

{{range .Classes -}}
{{$framework := $.Framework -}}
{{$className := .Name -}}
{{$structName := classToStructName .Name -}}
{{$varName := classToVarName .Name -}}
{{$classTypeName := print "_" $structName "Class" -}}
{{$classReceiver := receiverName $structName true -}}
{{$instReceiver := receiverName $structName false -}}

// The class instance for the [{{$structName}}] class.
var (
	{{$varName}}     {{$classTypeName}}
	{{$varName}}Once sync.Once
)

func get{{$structName}}Class() {{$classTypeName}} {
	{{$varName}}Once.Do(func() {
		{{$varName}} = {{$classTypeName}}{objc.GetClass("{{.Name}}")}
	})
	return {{$varName}}
}

type {{$classTypeName}} struct {
	class objc.Class
}

// An interface definition for the [{{$structName}}] class.
type I{{$structName}} interface {
	{{- if and .SuperClass (ne .SuperClass "NSObject")}}
	{{- $superStructName := classToStructName .SuperClass}}
	{{- $isSelfReferential := eq $superStructName $structName}}
	{{- if $isSelfReferential}}
	objectivec.IObject
	{{- else}}
	{{- $superResolved := resolveType $.Framework $superStructName}}
	{{- if hasPrefix $superResolved "foundation."}}
	foundation.I{{trimPrefix $superResolved "foundation."}}
	{{- else if hasPrefix $superResolved "appkit."}}
	appkit.I{{trimPrefix $superResolved "appkit."}}
	{{- else if hasPrefix $superResolved "quartzcore."}}
	quartzcore.I{{trimPrefix $superResolved "quartzcore."}}
	{{- else if hasPrefix $superResolved "objectivec."}}
	objectivec.I{{trimPrefix $superResolved "objectivec."}}
	{{- else}}
	I{{$superStructName}}
	{{- end}}
	{{- end}}
	{{- else if and (eq $.Framework "ObjectiveC") (eq .Name "NSObject")}}
	objc.IObject
	{{- else if eq $.Framework "ObjectiveC"}}
	IObject
	{{- else}}
	objectivec.IObject
	{{- end}}
	{{- range filterPropertyMethods .}}
	{{- if and (not (isEssentialSelector .Selector)) (not (isInheritedFromNSObject .Selector))}}
	{{- $goType := mapObjCTypeToGo .ReturnType $framework}}
	{{- $isInitMethod := hasPrefix .Selector "init"}}
	{{- $hasValidReturnType := or $isInitMethod (eq .ReturnType "") (eq .ReturnType "void") (ne $goType "")}}
	{{- if $hasValidReturnType}}
	{{.Name}}({{formatMethodParams $.Generator .}}){{if $isInitMethod}} {{$structName}}{{else}}{{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$goType}}{{end}}{{end}}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- range .Properties}}
	{{- if not .IsClassProperty}}
	{{- $typeToMap := .Type}}{{if .ObjCType}}{{$typeToMap = .ObjCType}}{{end}}
	{{- $goType := mapObjCTypeToGo $typeToMap $framework}}
	{{- $capitalizedName := capitalize .Name}}
	{{- $conflictsWithParent := propertyConflictsWithParent $className $.SuperClass .Name}}
	{{- if and (ne $goType "") (not $conflictsWithParent)}}
	{{$capitalizedName}}() {{$goType}}
	{{- $isReadOnly := contains .Attributes "readonly"}}
	{{- if not $isReadOnly}}
	{{- $setterParamType := typeToInterfaceType $ $goType}}
	Set{{$capitalizedName}}(value {{$setterParamType}})
	{{- end}}
	{{- end}}
	{{- end}}
	{{- end}}
	// DEBUG: {{len .Properties}} properties
}



{{if .Abstract -}}
// {{commentLine .Abstract}}
{{if .Overview}}//
// {{commentLine .Overview}}
{{end -}}
{{end -}}
{{if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
type {{$structName}} struct {
	{{getStructEmbeddedField . $.Framework}}
}

// {{$structName}}From constructs a [{{$structName}}] from an unsafe.Pointer.
{{if .Abstract -}}
//
// {{commentLine .Abstract}}
{{end -}}
func {{$structName}}From(ptr unsafe.Pointer) {{$structName}} {
	{{getFromConstructorBody . $.Framework}}
}

// Alloc allocates a new instance without initialization.
func ({{$classReceiver}} {{$classTypeName}}) Alloc() {{$structName}} {
	rv := objc.Send[{{$structName}}](objc.ID({{$classReceiver}}.class), objc.Sel("alloc"))
	return rv
}

// New creates and returns a new autoreleased instance (equivalent to [[Class alloc] init]).
// Note: Despite the name, this returns an autoreleased object for consistency with Go patterns.
func ({{$classReceiver}} {{$classTypeName}}) New() {{$structName}} {
	rv := objc.Send[{{$structName}}](objc.ID({{$classReceiver}}.class), objc.Sel("new"))
	rv.Autorelease()
	return rv
}

// Init initializes the instance.
func ({{$instReceiver}} {{$structName}}) Init() {{$structName}} {
	rv := objc.Send[{{$structName}}]({{$instReceiver}}.ID, objc.Sel("init"))
	return rv
}

// Autorelease adds the receiver to the current autorelease pool.
func ({{$instReceiver}} {{$structName}}) Autorelease() {{$structName}} {
	rv := objc.Send[{{$structName}}]({{$instReceiver}}.ID, objc.Sel("autorelease"))
	return rv
}

// New{{$structName}} creates a new {{$structName}} instance.
func New{{$structName}}() {{$structName}} {
	return get{{$structName}}Class().New()
}

{{if .HasInitMethods -}}
{{- range prepareInitMethodsWithClassName $className .Methods}}
{{- if ne .Selector "init"}}
{{- $constructorName := initMethodToConstructorName $className .Selector}}
{{- $paramNames := formatMethodParamNamesWithFramework . $framework}}
{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func {{$constructorName}}({{formatMethodParams $.Generator .}}) {{$structName}} {
{{getConstructorBody . $structName $paramNames}}
}
{{end}}
{{- end}}
{{end -}}
{{- range prepareClassMethods .Methods}}
{{- if not (isEssentialSelector .Selector)}}
{{- $paramNames := formatMethodParamNamesWithFramework . $framework}}
{{- $goType := mapObjCTypeToGo .ReturnType $framework}}
{{- /* If the method returns the same type as the class, use the wrapper type instead of the underlying struct */}}
{{- $returnType := $goType}}
{{- if eq $goType $className}}{{$returnType = $structName}}{{end}}

{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$classReceiver}} {{$classTypeName}}) {{.Name}}({{formatMethodParams $.Generator .}}){{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$returnType}}{{end}} {
	{{- if and (ne .ReturnType "") (ne .ReturnType "void")}}
	rv := objc.Send[{{$goType}}](objc.ID({{$classReceiver}}.class), objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	return rv
	{{- else}}
	objc.Send[objc.ID](objc.ID({{$classReceiver}}.class), objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- end}}
}
{{end}}
{{- end}}
{{- range .Properties}}
{{- if .IsClassProperty}}
{{- $goType := mapObjCTypeToGo .Type $framework}}
{{- /* If the property returns the same type as the class, use the wrapper type instead of the underlying struct */}}
{{- $returnType := $goType}}
{{- if eq $goType $className}}{{$returnType = $structName}}{{end}}
{{- $capitalizedName := capitalize .Name}}
{{- $conflictsWithParent := propertyConflictsWithParent $className $.Class.SuperClass .Name}}
{{- if and (ne $goType "") (not $conflictsWithParent)}}

{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$classReceiver}} {{$classTypeName}}) {{$capitalizedName}}() {{$returnType}} {
	rv := objc.Send[{{$goType}}](objc.ID({{$classReceiver}}.class), objc.Sel("{{.Name}}"))
	return rv
}
{{- end}}
{{- end}}
{{- end}}
{{- range filterPropertyMethods .}}
{{- if not (isEssentialSelector .Selector)}}
{{- $paramNames := formatMethodParamNamesWithFramework . $framework}}
{{- $goType := mapObjCTypeToGo .ReturnType $framework}}
{{- $isInitMethod := hasPrefix .Selector "init"}}
{{- $hasValidReturnType := or $isInitMethod (eq .ReturnType "") (eq .ReturnType "void") (ne $goType "")}}
{{- if $hasValidReturnType}}
{{- if or .Abstract .DocURL}}
{{template "doc_comment" .}}
{{end -}}
func ({{$instReceiver}} {{$structName}}) {{.Name}}({{formatMethodParams $.Generator .}}){{if $isInitMethod}} {{$structName}}{{else}}{{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$goType}}{{end}}{{end}} {
	{{- if $isInitMethod}}
	rv := objc.Send[{{$structName}}]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	return rv
	{{- else if and (ne .ReturnType "") (ne .ReturnType "void")}}
	rv := objc.Send[{{$goType}}]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	return rv
	{{- else}}
	objc.Send[objc.ID]({{$instReceiver}}.ID, objc.Sel("{{.Selector}}"){{if $paramNames}}, {{$paramNames}}{{end}})
	{{- end}}
}
{{- end}}
{{- end}}
{{- end}}

{{end -}}

-- class.gen.go --
// Code generated from Apple documentation for {{.Framework}}. DO NOT EDIT.

package {{.PackageName}}

import (
	"sync"
	"unsafe"

	"{{.OutputModule}}/objc"
{{- $imports := getClassImports .Class $.Framework $.OutputModule}}
{{- $sortedImports := getSortedClassImports $imports}}
{{- range $sortedImports}}
	"{{.ImportPath}}"
{{- end}}
)

{{with .Class -}}
{{$framework := $.Framework -}}
{{$className := .Name -}}
{{$structName := classToStructName .Name -}}
{{$varName := classToVarName .Name -}}
{{$classTypeName := print "_" $structName "Class" -}}
{{$classReceiver := receiverName $structName true -}}
{{$instReceiver := receiverName $structName false -}}

// The class instance for the [{{$structName}}] class.
var (
	{{$varName}}     {{$classTypeName}}
	{{$varName}}Once sync.Once
)

func get{{$structName}}Class() {{$classTypeName}} {
	{{$varName}}Once.Do(func() {
		{{$varName}} = {{$classTypeName}}{objc.GetClass("{{.Name}}")}
	})
	return {{$varName}}
}

type {{$classTypeName}} struct {
	class objc.Class
}

// An interface definition for the [{{$structName}}] class.
type I{{$structName}} interface {
	{{getInterfaceParent . $.Framework}}
	{{- range filterPropertyMethods .}}
	{{- if and (not (isEssentialSelector .Selector)) (not (isInheritedFromNSObject .Selector))}}
	{{- $goType := mapObjCTypeToGo .ReturnType $framework}}
	{{- $isInitMethod := hasPrefix .Selector "init"}}
	{{- $hasValidReturnType := or $isInitMethod (eq .ReturnType "") (eq .ReturnType "void") (ne $goType "")}}
	{{- if $hasValidReturnType}}
	{{.Name}}({{formatMethodParams $.Generator .}}){{if $isInitMethod}} {{$structName}}{{else}}{{if and (ne .ReturnType "") (ne .ReturnType "void")}} {{$goType}}{{end}}{{end}}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- range .Properties}}
	{{- if not .IsClassProperty}}
	{{- $typeToMap := .Type}}{{if .ObjCType}}{{$typeToMap = .ObjCType}}{{end}}
	{{- $goType := mapObjCTypeToGo $typeToMap $framework}}
	{{- $capitalizedName := capitalize .Name}}
	{{- $conflictsWithParent := propertyConflictsWithParent $className $.Class.SuperClass .Name}}
	{{- if and (ne $goType "") (not $conflictsWithParent)}}
	{{$capitalizedName}}() {{$goType}}
	{{- $isReadOnly := contains .Attributes "readonly"}}
	{{- if not $isReadOnly}}
	{{- $setterParamType := typeToInterfaceType $ $goType}}
	Set{{$capitalizedName}}(value {{$setterParamType}})
	{{- end}}
	{{- end}}
	{{- end}}
	{{- end}}
}

{{if .Abstract -}}
// {{commentLine .Abstract}}
{{if .Overview}}//
// {{commentLine .Overview}}
{{end -}}
{{end -}}
{{if or .Abstract .DocURL}}
