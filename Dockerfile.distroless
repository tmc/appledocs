# Distroless Dockerfile for appledocs
# Provides good security with better debugging capabilities than scratch

# Build stage
FROM golang:1.24-alpine AS builder

# Security updates
RUN apk update && apk upgrade && apk add --no-cache git

WORKDIR /build

# Dependencies
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Source code
COPY . .

# Build binary with security flags
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -trimpath \
    -o appledocs .

# Create directory structure
RUN mkdir -p /app/cache /app/output

# Final stage - Google's distroless image
FROM gcr.io/distroless/static-debian12:nonroot

# Copy binary and directories
COPY --from=builder /build/appledocs /appledocs
COPY --from=builder --chown=nonroot:nonroot /app /app

# Set working directory
WORKDIR /app

# Document volumes
VOLUME ["/app/cache", "/app/output"]

# Metadata
LABEL security.scan="true" \
      security.base="distroless" \
      security.nonroot="true"

# Already running as nonroot user (uid 65532)
ENTRYPOINT ["/appledocs"]
CMD ["-cache", "/app/cache", "-output", "/app/output"]