{
  "default": true,
  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD007": {
    "indent": 2
  },
  "MD013": {
    "line_length": 120,
    "heading_line_length": 100,
    "code_block_line_length": 150,
    "code_blocks": false,
    "tables": false,
    "headings": true,
    "headers": true
  },
  "MD024": {
    "siblings_only": true
  },
  "MD025": {
    "level": 1
  },
  "MD026": {
    "punctuation": ".,;:!"
  },
  "MD029": {
    "style": "ordered"
  },
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "MD033": {
    "allowed_elements": ["details", "summary", "br", "sup", "sub"]
  },
  "MD035": {
    "style": "---"
  },
  "MD036": {
    "punctuation": ".,;:!?。，；：！？"
  },
  "MD041": {
    "level": 1
  },
  "MD044": {
    "names": [
      "JavaScript",
      "TypeScript",
      "GitHub",
      "GitLab",
      "JSON",
      "YAML",
      "API",
      "URL",
      "HTTP",
      "HTTPS",
      "CI/CD",
      "macOS",
      "iOS",
      "SwiftUI",
      "EndpointSecurity"
    ],
    "code_blocks": false
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "underscore"
  },
  "MD050": {
    "style": "asterisk"
  },
  "no-hard-tabs": true,
  "no-bare-urls": false,
  "no-inline-html": false
}